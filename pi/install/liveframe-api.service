[Unit]
Description=LiveFrame API + player
After=network.target local-fs.target
RequiresMountsFor=/media/liveframe

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/liveframe
Environment=LIVEFRAME_CONFIG=/opt/liveframe/config.yaml
ExecStart=/opt/liveframe/.venv/bin/python -m liveframe.api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
