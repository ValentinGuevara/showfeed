[Unit]
Description=ShowFeed inbox watcher
After=network.target local-fs.target
RequiresMountsFor=/media/showfeed

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/showfeed
Environment=SHOWFEED_CONFIG=/opt/showfeed/config.yaml
ExecStart=/opt/showfeed/.venv/bin/python -m showfeed.watcher
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
